#!/bin/sh
# Set the initial Plasma wallpaper once; later user changes remain untouched.
set -eu
wallpaper=/usr/share/backgrounds/lyriq/agentos-horizon-v1.png
marker="${XDG_CONFIG_HOME:-$HOME/.config}/agentos/wallpaper-initialized"
[ -f "$wallpaper" ] || exit 0
[ ! -f "$marker" ] || exit 0
command -v plasma-apply-wallpaperimage >/dev/null 2>&1 || exit 0
attempt=0
while [ "$attempt" -lt 30 ]; do
  if plasma-apply-wallpaperimage "$wallpaper"; then
    mkdir -p "$(dirname "$marker")"
    : > "$marker"
    exit 0
  fi
  attempt=$((attempt + 1))
  sleep 2
done
exit 1
